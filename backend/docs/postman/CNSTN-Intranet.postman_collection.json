                  "const json = pm.response.json();",
                  "pm.environment.set('eventId', json.id);",
                  "pm.test('Event créé', () => pm.expect(json.id).to.exist);"
                ]
              }
            }
          ]
        },
        {
          "name": "Decision Event (CHEF_HIERARCHIQUE)",
          "request": {
            "method": "PUT",
            "header": [
